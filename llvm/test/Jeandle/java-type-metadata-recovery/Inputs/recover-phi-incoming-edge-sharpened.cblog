GetFieldType 22 16 = 31
IsUnverifiedInterface 31 = false
IsEffectivelyFinal 31 = false
ArrayElementKlass 5 = 0
GetFieldType 5 16 = 30
IsUnverifiedInterface 30 = false
IsEffectivelyFinal 30 = false

