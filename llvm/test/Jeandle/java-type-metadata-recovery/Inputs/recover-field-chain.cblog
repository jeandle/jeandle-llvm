# Constant oop 0 has runtime klass 5 (Root).
# Root.field@16 -> klass 7 (Child). Child.field@20 -> klass 9 (Grand), final.
GetOopKlass 0 = 5
GetFieldType 5 16 = 7
IsUnverifiedInterface 7 = false
IsEffectivelyFinal 7 = false
GetFieldType 7 20 = 9
IsUnverifiedInterface 9 = false
IsEffectivelyFinal 9 = true
# No object-array klass reaches the dispatch: element query returns 0.
ArrayElementKlass 5 = 0
ArrayElementKlass 7 = 0

IsInterface 5 = false
GetSecondarySupers 5 = []
IsInterface 7 = false
GetSecondarySupers 7 = []
IsInterface 9 = false
GetSecondarySupers 9 = []