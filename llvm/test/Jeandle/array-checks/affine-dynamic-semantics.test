# REQUIRES: native
# RUN: %python %s opt lli %t | FileCheck %s
# CHECK: 1296 dynamic-step and handler-state cases passed

from pathlib import Path
import random
import subprocess
import sys

opt, lli, directory = sys.argv[1:]
directory = Path(directory)
directory.mkdir(parents=True, exist_ok=True)

# Both the first failing index and effects before that failure are observable.
header = r'''@effects = global i32 0
@fmt = private constant [7 x i8] c"%d:%d\0A\00"
declare i32 @printf(ptr, ...)
define void @effect(i32 %value) {
  %old = load i32, ptr @effects
  %scaled = mul i32 %old, 17
  %new = add i32 %scaled, %value
  store i32 %new, ptr @effects
  ret void
}
define i32 @handler(i32 %bad, i32 %partial, i32 %stage) {
  call void @effect(i32 %stage)
  %a = xor i32 %partial, %bad
  %result = add i32 %a, %stage
  ret i32 %result
}
'''

controllers = [('slt', 1), ('sle', 3), ('sgt', -1), ('sge', -3),
               ('ult', 1), ('ule', 3), ('ugt', -1), ('uge', -3), ('ne', 2)]
functions = []
for number, (predicate, step) in enumerate(controllers):
    functions.append(f'''define i32 @loop{number}(i8 noundef %start, i8 noundef %limit,
    i32 noundef %offset, i32 noundef %otheroffset, i32 noundef %scale,
    i1 noundef %other) {{
entry:
  br label %loop
loop:
  %i = phi i8 [ %start, %entry ], [ %next, %latch ]
  %x = phi i32 [ %offset, %entry ], [ %xnext, %latch ]
  %y = phi i32 [ %otheroffset, %entry ], [ %ynext, %latch ]
  %sum = phi i32 [ 0, %entry ], [ %newsum, %latch ]
  %fuel = phi i32 [ 0, %entry ], [ %fuelnext, %latch ]
  call void @effect(i32 %sum)
  %ok = icmp ult i32 %x, 32
  br i1 %ok, label %first, label %fail
first:
  call void @effect(i32 %x)
  %newsum = add i32 %sum, %x
  %ok2 = icmp ult i32 %y, 32
  %both = select i1 %other, i1 %ok2, i1 false
  br i1 %both, label %body, label %fail
body:
  %fuelnext = add i32 %fuel, 1
  %enough = icmp eq i32 %fuelnext, 20
  br i1 %enough, label %cutoff, label %latch
latch:
  %xnext = add i32 %x, %scale
  %ynext = add i32 %y, -3
  %next = add i8 %i, {step}
  %again = icmp {predicate} i8 %next, %limit
  br i1 %again, label %loop, label %exit
fail:
  %bad = phi i32 [ %x, %loop ], [ %y, %first ]
  %partial = phi i32 [ %sum, %loop ], [ %newsum, %first ]
  %stage = phi i32 [ 101, %loop ], [ 202, %first ]
  %failure = call i32 @handler(i32 %bad, i32 %partial, i32 %stage)
  ret i32 %failure
cutoff:
  ret i32 %newsum
exit:
  ret i32 %newsum
}}
''')

rng = random.Random(181119)
cases = []
scales = [-2147483648, -2147483647, -32, -3, -1, 0, 1, 3,
          31, 32, 2147483646, 2147483647]
for number in range(len(controllers)):
    for scale in scales:
        for variant in range(12):
            start = rng.choice([-128, -127, -3, -1, 0, 1, 3, 126, 127])
            limit = rng.choice([-128, -127, -3, -1, 0, 1, 3, 126, 127])
            offset = rng.choice([-2147483648, -1, 0, 1, 10, 31, 32, 2147483647])
            otheroffset = rng.choice([-1, 0, 1, 10, 31, 32])
            cases.append((number, start, limit, offset, otheroffset, scale,
                          'true' if variant % 3 else 'false'))

main = ['define i32 @main() {', 'entry:']
for number, case in enumerate(cases):
    function, start, limit, offset, otheroffset, scale, other = case
    main.extend([
        '  store i32 0, ptr @effects',
        f'  %r{number} = call i32 @loop{function}(i8 {start}, i8 {limit}, '
        f'i32 {offset}, i32 {otheroffset}, i32 {scale}, i1 {other})',
        f'  %e{number} = load i32, ptr @effects',
        f'  %p{number} = call i32 (ptr, ...) @printf(ptr @fmt, '
        f'i32 %r{number}, i32 %e{number})'])
main.extend(['  ret i32 0', '}'])
source = header + '\n'.join(functions + main) + '\n!java-method-compilation = !{}\n'
input_path = directory / 'input.ll'
input_path.write_text(source)
command = [opt, '-passes=loop-simplify,lcssa,jeandle-affine-check-versioning',
           '-verify-each', '-S', str(input_path)]
transformed = subprocess.check_output(command, text=True)
assert transformed.count('.affine.fast:') == len(controllers), \
    'every signed/unsigned controller must reach affine versioning'
assert transformed.count('select i1 %other, i1 true, i1 false') == len(controllers), \
    'the unproved conjunct must remain on every fast path'

results = []
for name, text in [('reference', source), ('versioned', transformed)]:
    path = directory / (name + '.ll')
    path.write_text(text)
    result = subprocess.check_output([lli, str(path)], timeout=90)
    (directory / (name + '.txt')).write_bytes(result)
    results.append(result)
assert results[0] == results[1], 'dynamic step changed results or partial effects'
print(f'{len(cases)} dynamic-step and handler-state cases passed')
